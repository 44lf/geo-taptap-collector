{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::geo-taptap-inbox"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::geo-taptap-inbox",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "incoming/*",
            "ready/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::geo-taptap-inbox/incoming/*",
        "arn:aws:s3:::geo-taptap-inbox/ready/*"
      ]
    }
  ]
}
